{
  "name": "ad-blocker",
  "version": "0.1.0",
  "private": true,
  "description": "Development preview of a privacy-first Chrome MV3 ad blocker",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run verify && npm run test",
    "build": "node scripts/build.mjs",
    "test:e2e": "node tests/chromium-smoke.mjs",
    "verify:archives": "node scripts/verify-snapshots.mjs",
    "build:ublock": "node scripts/build-ublock-node.mjs",
    "test:ublock": "npm run build:ublock && node --test tests/upstream/ublock.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  },
  "engines": {
    "node": ">=22"
  }
}
